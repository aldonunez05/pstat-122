tuk <- TukeyHSD(model, which = "trt")
insulate <- read.table("insulate1.txt", header = TRUE)
insulate$Cut  <- as.factor(insulate$Cut)
insulate$Lot <- as.factor(insulate$Lot)
head(insulate)
freq_table <- table(insulate$Cut, insulate$Lot )
freq_table
library(ggplot2)
ggplot(insulate, aes(x = Cut, y = Strength, fill = Cut)) +
geom_boxplot() +
labs(title = "Figure 1: Insulation Strength by Cut Type",
x = "Cut Type", y = "Strength (ft-lbs)") +
theme_minimal()
model_a <- aov(Strength ~ Cut, data = insulate)
summary(model_a)
ggplot(insulate, aes(x = Lot, y = Strength, fill = Lot)) +
geom_boxplot() +
labs(title = "Figure 2: Insulation Strength by Lot Number",
x = "Lot Number", y = "Strength (ft-lbs)") +
theme_minimal() +
theme(legend.position = "none")
model_c <- aov(Strength ~ Cut + Lot, data = insulate)
summary(model_c)
par(mfrow = c(2,2))
plot(model_c, main = "")
shapiro.test(residuals(model_c))
library("agricolae")
set.seed(100)
treatments <- paste0("Blend", LETTERS[1:6])
# Then pass the variable (not the expression) to design.bib()
design <- design.bib(trt = treatments, k = 3, r = 5, seed = 123)
head(design$book)
library(dplyr)
set.seed(100)
data <- design$book %>% rename(trt = treatments) %>%
mutate(Score = round(7 +
ifelse(trt == "BlendA", 1, 0.5) +  # Blend A slightly better
rnorm(n(), 0, 1), 1))
head(data)
str(data)
summary(data$Score)
library(ggplot2)
ggplot(data, aes(x = trt, y = Score, fill = trt)) +
geom_boxplot() +
labs(title = "Coffee Blend Taste Scores",
x = "Coffee Blend",
y = "Taste Score") +
theme_minimal()
model <- aov(Score ~ trt + block, data = data)
summary(model)
model <- aov(Score ~ trt + block, data = data)
summary(model)
model_trt_only <- aov(Score ~ trt, data = data)
summary(model_trt_only)
tuk <- TukeyHSD(model, which = "trt")
plot(tuk, las = 1)
knitr::opts_chunk$set(message =  FALSE)
knitr::opts_chunk$set(warning =  FALSE)
knitr::opts_chunk$set(error =  FALSE)
bfcolor <- function(x, color) {
if (knitr::is_latex_output()) {
sprintf("\\textcolor{%s}{\\textbf{%s}}", color, x)
} else if (knitr::is_html_output()) {
sprintf("<span style='color: %s;'><b>%s</b></span>", color, x)
} else x
}
